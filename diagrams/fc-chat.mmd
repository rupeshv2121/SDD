flowchart TD
  A(["Start"]):::term --> B[/"Student sends message"/]:::io
  B --> C{"Within rate limit and<br/>at most 1000 chars?"}
  C -->|"no"| C1[/"429 or 400"/]:::io --> Z
  C -->|"yes"| D["Build conversation:<br/>system prompt + last 6 turns"]
  D --> E["Call LLM with tool schemas"]
