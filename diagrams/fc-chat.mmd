  F -->|"yes"| G{"Round count<br/>at most 3?"}
  G -->|"yes"| H["Run tool with userId from JWT;<br/>reject forbidden params"]
  H --> E
  G -->|"no"| I["Stop tool use"]
  F -->|"no"| J[/"Return answer,<br/>labelled AI"/]:::io
  I --> J
  J --> Z(["End"]):::term

