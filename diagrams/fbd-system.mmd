  GW --> M1
  GW --> M4
  GW --> M10
  CRON -->|"/api/internal/cron/daily"| M10
  M14 --> DB
  M9 --> DB
  M15 --> DB
  M9 -->|"embed, generate,<br/>read image"| AIP
  M15 ~~~ MSG
  M11 -.->|"email, chat, push"| MSG
  M12 -.-> OBJ

